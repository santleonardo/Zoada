// ============================================================
// ZÔADA — Prisma Schema for Neon (Postgres)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------- Usuários ----------
model Usuario {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String    @default("")
  avatarUrl         String?
  bio               String?
  passwordHash      String?   @map("password_hash")
  lastSeenAt        DateTime? @map("last_seen_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  seguidoresCount   Int       @default(0) @map("seguidores_count")
  seguindoCount     Int       @default(0) @map("seguindo_count")

  curtidas     Curtida[]
  comentarios  Comentario[]
  enviado      Mensagem[] @relation("Enviadas")
  recebido     Mensagem[] @relation("Recebidas")
  artistas     Artista[]
  seguindo     Seguindo[]
  reproducoes  Reproducao[]
  seguidores   SeguirUsuario[] @relation("Seguindo")
  seguidos     SeguirUsuario[] @relation("Seguidos")

  @@map("usuarios")
}

// ---------- Artistas ----------
model Artista {
  id             String   @id @default(cuid())
  usuarioId      String?  @map("usuario_id")
  usuario        Usuario? @relation(fields: [usuarioId], references: [id])
  nome           String
  avatarUrl      String?  @map("avatar_url")
  coverUrl       String?  @map("cover_url")
  bio            String   @default("")
  genero         String   @default("") @map("genero")
  seguidoresCount Int      @default(0) @map("seguidores_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  faixas     Faixa[]
  seguidores Seguindo[]

  @@map("artistas")
}

// ---------- Faixas (músicas) ----------
model Faixa {
  id          String   @id @default(cuid())
  titulo      String
  artistaId   String   @map("artista_id")
  coverUrl    String?  @map("cover_url")
  audioUrl    String?  @map("audio_url")
  duracao     Int      @default(0) @map("duracao")
  playsCount  Int      @default(0) @map("plays_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  artista     Artista     @relation(fields: [artistaId], references: [id], onDelete: Cascade)
  curtidas    Curtida[]
  comentarios Comentario[]
  mensagens   Mensagem[]
  reproducoes Reproducao[]

  @@map("faixas")
}

// ---------- Curtidas ----------
model Curtida {
  id        String   @id @default(cuid())
  usuarioId String   @map("usuario_id")
  faixaId   String   @map("faixa_id")
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  faixa   Faixa   @relation(fields: [faixaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, faixaId])
  @@map("curtidas")
}

// ---------- Reproduções ----------
model Reproducao {
  id        String   @id @default(cuid())
  usuarioId String   @map("usuario_id")
  faixaId   String   @map("faixa_id")
  vezes     Int      @default(0) @map("vezes")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  faixa   Faixa   @relation(fields: [faixaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, faixaId])
  @@map("reproducoes")
}

// ---------- Seguindo (usuário segue artista) ----------
model Seguindo {
  id        String   @id @default(cuid())
  usuarioId String   @map("usuario_id")
  artistaId String   @map("artista_id")
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  artista Artista @relation(fields: [artistaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, artistaId])
  @@map("seguindo")
}

// ---------- Seguir Usuário ----------
model SeguirUsuario {
  id          String   @id @default(cuid())
  seguidorId  String   @map("seguidor_id")
  seguidoId   String   @map("seguido_id")
  createdAt   DateTime @default(now()) @map("created_at")

  seguidor Usuario @relation("Seguindo", fields: [seguidorId], references: [id], onDelete: Cascade)
  seguido  Usuario @relation("Seguidos", fields: [seguidoId], references: [id], onDelete: Cascade)

  @@unique([seguidorId, seguidoId])
  @@index([seguidoId])
  @@map("seguir_usuarios")
}

// ---------- Comentários ----------
model Comentario {
  id        String   @id @default(cuid())
  usuarioId String   @map("usuario_id")
  faixaId   String   @map("faixa_id")
  conteudo  String
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  faixa   Faixa   @relation(fields: [faixaId], references: [id], onDelete: Cascade)

  @@map("comentarios")
}

// ---------- Mensagens (chat) ----------
model Mensagem {
  id             String   @id @default(cuid())
  remetenteId    String   @map("remetente_id")
  destinatarioId String   @map("destinatario_id")
  conteudo       String
  faixaId        String?  @map("faixa_id")
  lida           Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  remetente   Usuario  @relation("Enviadas", fields: [remetenteId], references: [id], onDelete: Cascade)
  destinatario Usuario @relation("Recebidas", fields: [destinatarioId], references: [id], onDelete: Cascade)
  faixa       Faixa?   @relation(fields: [faixaId], references: [id], onDelete: SetNull)

  @@index([remetenteId])
  @@index([destinatarioId])
  @@index([createdAt])
  @@index([faixaId])
  @@map("mensagens")
}
