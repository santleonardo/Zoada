// ============================================================
// ZÔADA — Prisma Schema (SQLite)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Usuários ----------
model Usuario {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String   @default("")
  avatarUrl       String?
  bio             String?
  passwordHash    String?
  lastSeenAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  seguidoresCount Int      @default(0)
  seguindoCount   Int      @default(0)

  curtidas     Curtida[]
  comentarios  Comentario[]
  enviado      Mensagem[] @relation("Enviadas")
  recebido     Mensagem[] @relation("Recebidas")
  artistas     Artista[]
  seguindo     Seguindo[]
  reproducoes  Reproducao[]
  seguidores   SeguirUsuario[] @relation("Seguindo")
  seguidos     SeguirUsuario[] @relation("Seguidos")

  @@map("usuarios")
}

// ---------- Artistas ----------
model Artista {
  id             String   @id @default(cuid())
  usuarioId      String?
  usuario        Usuario? @relation(fields: [usuarioId], references: [id])
  nome           String
  avatarUrl      String?
  coverUrl       String?
  bio            String   @default("")
  genero         String   @default("")
  seguidoresCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  faixas      Faixa[]
  seguidores Seguindo[]

  @@map("artistas")
}

// ---------- Faixas (músicas) ----------
model Faixa {
  id         String   @id @default(cuid())
  titulo     String
  artistaId  String
  coverUrl   String?
  audioUrl   String?
  duracao    Int      @default(0)
  playsCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  artista     Artista     @relation(fields: [artistaId], references: [id], onDelete: Cascade)
  curtidas    Curtida[]
  comentarios Comentario[]
  mensagens   Mensagem[]
  reproducoes Reproducao[]

  @@map("faixas")
}

// ---------- Curtidas ----------
model Curtida {
  id        String   @id @default(cuid())
  usuarioId String
  faixaId   String
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  faixa   Faixa   @relation(fields: [faixaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, faixaId])
  @@map("curtidas")
}

// ---------- Reproduções ----------
model Reproducao {
  id        String   @id @default(cuid())
  usuarioId String
  faixaId   String
  vezes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  faixa   Faixa   @relation(fields: [faixaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, faixaId])
  @@map("reproducoes")
}

// ---------- Seguindo (usuário segue artista) ----------
model Seguindo {
  id        String   @id @default(cuid())
  usuarioId String
  artistaId String
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  artista Artista @relation(fields: [artistaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, artistaId])
  @@map("seguindo")
}

// ---------- Seguir Usuário ----------
model SeguirUsuario {
  id         String   @id @default(cuid())
  seguidorId String
  seguidoId  String
  createdAt  DateTime @default(now())

  seguidor Usuario @relation("Seguindo", fields: [seguidorId], references: [id], onDelete: Cascade)
  seguido  Usuario @relation("Seguidos", fields: [seguidoId], references: [id], onDelete: Cascade)

  @@unique([seguidorId, seguidoId])
  @@map("seguir_usuarios")
}

// ---------- Comentários ----------
model Comentario {
  id        String   @id @default(cuid())
  usuarioId String
  faixaId   String
  conteudo  String
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  faixa   Faixa   @relation(fields: [faixaId], references: [id], onDelete: Cascade)

  @@map("comentarios")
}

// ---------- Mensagens (chat) ----------
model Mensagem {
  id             String   @id @default(cuid())
  remetenteId    String
  destinatarioId String
  conteudo       String
  faixaId        String?
  lida           Boolean  @default(false)
  createdAt      DateTime @default(now())

  remetente   Usuario @relation("Enviadas", fields: [remetenteId], references: [id], onDelete: Cascade)
  destinatario Usuario @relation("Recebidas", fields: [destinatarioId], references: [id], onDelete: Cascade)
  faixa       Faixa?   @relation(fields: [faixaId], references: [id], onDelete: SetNull)

  @@map("mensagens")
}
