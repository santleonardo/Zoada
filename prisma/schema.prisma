// ============================================================
// ZÔADA — Prisma Schema for Neon (Postgres)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------- Usuários ----------
model Usuario {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String    @default("")
  avatarUrl         String?
  bio               String?
  passwordHash      String?   @map("password_hash")
  lastSeenAt        DateTime? @map("last_seen_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  seguidoresCount   Int       @default(0) @map("seguidores_count")
  seguindoCount     Int       @default(0) @map("seguindo_count")
  // Soft-delete: quando a conta é "excluída" pelo usuário, isso é marcado
  // aqui em vez de apagar a linha na hora. Fica 30 dias assim — fazendo
  // login de novo com a senha certa dentro desse prazo restaura tudo. Um
  // job (ver /api/cron/purge-deleted) apaga de vez o que passou dos 30 dias.
  deletedAt         DateTime? @map("deleted_at")

  curtidas     Curtida[]
  favoritos    Favorito[]
  comentarios  Comentario[]
  comentariosPostagem ComentarioPostagem[]
  curtidasComentarioPostagem CurtidaComentarioPostagem[]
  curtidasPostagem CurtidaPostagem[]
  comentariosRadio ComentarioRadio[]
  enviado      Mensagem[] @relation("Enviadas")
  mensagensModeracao MensagemModeracao[]
  recebido     Mensagem[] @relation("Recebidas")
  artistas     Artista[]
  seguindo     Seguindo[]
  reproducoes  Reproducao[]
  seguidores   SeguirUsuario[] @relation("Seguindo")
  seguidos     SeguirUsuario[] @relation("Seguidos")
  estacoesRadio EstacaoRadio[]
  postagens    Postagem[]
  denuncias    Denuncia[]

  @@map("usuarios")
}

// ---------- Artistas ----------
model Artista {
  id             String   @id @default(cuid())
  // Dono do perfil de artista (o usuário logado que fez o upload). Nullable
  // pra não quebrar artistas antigos/seed que não têm dono. Uma conta pode
  // ter VÁRIOS artistas (ex: alguém populando o catálogo com diferentes
  // artistas fictícios) — por isso não é @unique: o que impede um artista
  // de "virar" outro é o app sempre criar um registro novo para um nome
  // novo, em vez de reaproveitar/reescrever um artista já existente.
  usuarioId      String?  @map("usuario_id")
  usuario        Usuario? @relation(fields: [usuarioId], references: [id])
  nome           String
  avatarUrl      String?  @map("avatar_url")
  coverUrl       String?  @map("cover_url")
  bio            String   @default("")
  genero         String   @default("") @map("genero")
  seguidoresCount Int      @default(0) @map("seguidores_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  // Soft-delete: ver comentário em Usuario.deletedAt — mesma lógica de
  // janela de 30 dias, restaurável pelo painel de Lixeira.
  deletedAt      DateTime? @map("deleted_at")

  faixas   Faixa[]
  seguidores Seguindo[]

  @@index([deletedAt])
  @@map("artistas")
}

// ---------- Faixas (músicas) ----------
model Faixa {
  id          String   @id @default(cuid())
  titulo      String
  artistaId   String   @map("artista_id")
  coverUrl    String?  @map("cover_url")
  audioUrl    String?  @map("audio_url")
  // Versão "economia de dados" da faixa (mesma música, bitrate mais baixo,
  // gerada no navegador do artista no momento do upload com ffmpeg.wasm).
  // Null para faixas enviadas antes dessa funcionalidade existir — nesse
  // caso o player cai de volta pra audioUrl mesmo em modo economia.
  audioUrlLow String?  @map("audio_url_low")
  duracao     Int      @default(0) @map("duracao") // segundos
  playsCount  Int      @default(0) @map("plays_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  // Soft-delete: ver comentário em Usuario.deletedAt.
  deletedAt   DateTime? @map("deleted_at")

  artista    Artista     @relation(fields: [artistaId], references: [id], onDelete: Cascade)
  curtidas   Curtida[]
  favoritos  Favorito[]
  comentarios Comentario[]
  mensagens  Mensagem[]
  reproducoes Reproducao[]
  faixasEstacao FaixaEstacao[]
  faixasRadioPadrao FaixaRadioPadrao[]
  postagens  Postagem[]

  @@index([deletedAt])
  @@map("faixas")
}

// ---------- Curtidas ----------
model Curtida {
  id        String   @id @default(cuid())
  usuarioId String   @map("usuario_id")
  faixaId   String   @map("faixa_id")
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  faixa   Faixa   @relation(fields: [faixaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, faixaId])
  @@map("curtidas")
}

// ---------- Favoritos ----------
// Diferente de Curtida (ação pública de "curtir"), Favorito é a faixa que o
// usuário salvou pra achar fácil depois (estrela na vitrine/aba "Favoritos").
// Antes só existia no localStorage do próprio aparelho; agora é persistido
// no servidor também pra contar como sinal de popularidade no ranking
// "Mais tocadas" da Início (junto com plays, curtidas, comentários,
// compartilhamentos e postagens no feed).
model Favorito {
  id        String   @id @default(cuid())
  usuarioId String   @map("usuario_id")
  faixaId   String   @map("faixa_id")
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  faixa   Faixa   @relation(fields: [faixaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, faixaId])
  @@map("favoritos")
}

// ---------- Reproduções (quantas vezes CADA usuário ouviu CADA faixa) ----------
// Diferente de faixas.playsCount (contagem global, pública, de qualquer
// ouvinte), esta tabela guarda um contador por par usuário+faixa, usado
// para montar o "Mais ouvidas" no perfil de cada pessoa.
model Reproducao {
  id        String   @id @default(cuid())
  usuarioId String   @map("usuario_id")
  faixaId   String   @map("faixa_id")
  vezes     Int      @default(0) @map("vezes")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  faixa   Faixa   @relation(fields: [faixaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, faixaId])
  @@map("reproducoes")
}

// ---------- Seguindo (usuário segue artista) ----------
model Seguindo {
  id        String   @id @default(cuid())
  usuarioId String   @map("usuario_id")
  artistaId String   @map("artista_id")
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  artista Artista @relation(fields: [artistaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, artistaId])
  @@map("seguindo")
}

// ---------- Seguir Usuário (usuário segue outro usuário) ----------
model SeguirUsuario {
  id              String   @id @default(cuid())
  seguidorId      String   @map("seguidor_id")
  seguidoId       String   @map("seguido_id")
  createdAt       DateTime @default(now()) @map("created_at")

  seguidor Usuario @relation("Seguindo", fields: [seguidorId], references: [id], onDelete: Cascade)
  seguido  Usuario @relation("Seguidos", fields: [seguidoId], references: [id], onDelete: Cascade)

  @@unique([seguidorId, seguidoId])
  @@index([seguidoId])
  @@map("seguir_usuarios")
}

// ---------- Comentários ----------
model Comentario {
  id        String   @id @default(cuid())
  usuarioId String   @map("usuario_id")
  faixaId   String   @map("faixa_id")
  conteudo  String
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  faixa   Faixa   @relation(fields: [faixaId], references: [id], onDelete: Cascade)

  @@map("comentarios")
}

// ---------- Postagens (usuário compartilha uma faixa e/ou um texto no próprio feed) ----------
// Diferente de Curtida (like privado) e de Mensagem com faixa (compartilhado
// só com um contato), uma Postagem é pública: aparece no perfil do usuário
// (e no feed geral da aba Fãs) pra qualquer visitante ver. Pode ser: só uma
// música (com legenda opcional), só um texto (post livre, sem faixa), ou os
// dois juntos. onDelete SetNull na faixa: se a faixa original for apagada,
// a postagem continua existindo (só perde o link tocável) — onDelete
// Cascade no usuário: se a conta for apagada, as postagens somem junto.
model Postagem {
  id        String   @id @default(cuid())
  usuarioId String   @map("usuario_id")
  faixaId   String?  @map("faixa_id")
  // Texto da postagem — legenda da música (quando há faixa) ou o conteúdo
  // inteiro de um post livre (quando não há faixa).
  legenda   String?  @map("legenda")
  createdAt DateTime @default(now()) @map("created_at")
  // Soft-delete: ver comentário em Usuario.deletedAt.
  deletedAt DateTime? @map("deleted_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  faixa   Faixa?  @relation(fields: [faixaId], references: [id], onDelete: SetNull)
  comentarios ComentarioPostagem[]
  curtidas    CurtidaPostagem[]

  @@index([usuarioId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("postagens")
}

// ---------- Reações (coração) na postagem em si (o OP que inicia a thread) ----------
// Diferente de CurtidaComentarioPostagem (reação num comentário da thread),
// esta é a reação na postagem original. Mesmo esquema de toggle: um usuário
// só pode reagir uma vez por postagem.
model CurtidaPostagem {
  id         String   @id @default(cuid())
  usuarioId  String   @map("usuario_id")
  postagemId String   @map("postagem_id")
  createdAt  DateTime @default(now()) @map("created_at")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  postagem Postagem @relation(fields: [postagemId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, postagemId])
  @@index([postagemId])
  @@map("curtidas_postagem")
}

// ---------- Comentários de postagem (thread no feed) ----------
// Diferente de Comentario (comentário numa FAIXA, mostrado no player), este
// é o comentário numa POSTAGEM do feed (aba "Fãs" e feed do perfil) — forma
// uma thread simples, em ordem cronológica, por baixo de cada postagem.
model ComentarioPostagem {
  id         String   @id @default(cuid())
  usuarioId  String   @map("usuario_id")
  postagemId String   @map("postagem_id")
  conteudo   String
  createdAt  DateTime @default(now()) @map("created_at")
  // Soft-delete: ver comentário em Usuario.deletedAt.
  deletedAt  DateTime? @map("deleted_at")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  postagem Postagem @relation(fields: [postagemId], references: [id], onDelete: Cascade)
  curtidas CurtidaComentarioPostagem[]

  @@index([postagemId])
  @@index([deletedAt])
  @@map("comentarios_postagem")
}

// ---------- Reações (coração) nos comentários da thread de postagem ----------
// Reação simples de "coração" (as cores da logo) num comentário da thread do
// feed — diferente de Curtida (que é sobre FAIXA). Um usuário só pode reagir
// uma vez por comentário (toggle liga/desliga).
model CurtidaComentarioPostagem {
  id           String   @id @default(cuid())
  usuarioId    String   @map("usuario_id")
  comentarioId String   @map("comentario_id")
  createdAt    DateTime @default(now()) @map("created_at")

  usuario    Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  comentario ComentarioPostagem @relation(fields: [comentarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, comentarioId])
  @@index([comentarioId])
  @@map("curtidas_comentario_postagem")
}

// ---------- Comentários gerais da rádio (chat, sem vínculo com faixa) ----------
model ComentarioRadio {
  id        String   @id @default(cuid())
  usuarioId String   @map("usuario_id")
  conteudo  String
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("comentarios_radio")
}

// ---------- Mensagens (chat) ----------
model Mensagem {
  id           String   @id @default(cuid())
  remetenteId  String   @map("remetente_id")
  destinatarioId String  @map("destinatario_id")
  conteudo      String
  // Faixa compartilhada nessa mensagem (opcional). Quando preenchida, o
  // chat renderiza um "cartão de música" tocável em vez de um balão de
  // texto comum. onDelete SetNull: se a faixa original for apagada, a
  // mensagem continua existindo (só perde o link tocável).
  faixaId       String?  @map("faixa_id")
  lida          Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  remetente  Usuario @relation("Enviadas", fields: [remetenteId], references: [id], onDelete: Cascade)
  destinatario Usuario @relation("Recebidas", fields: [destinatarioId], references: [id], onDelete: Cascade)
  faixa      Faixa?  @relation(fields: [faixaId], references: [id], onDelete: SetNull)

  @@index([remetenteId])
  @@index([destinatarioId])
  @@index([createdAt])
  @@index([faixaId])
  @@map("mensagens")
}

// Quem mandou uma mensagem no canal de suporte/moderação: o próprio
// usuário, ou alguém do time de moderação respondendo pelo painel externo
// (public/moderacao/index.html, autenticado com MODERATION_SECRET).
enum RemetenteModeracao {
  USUARIO
  MODERADOR
}

// Canal de mensagens direto entre um usuário e a moderação — diferente de
// Denuncia (que é sobre um conteúdo específico), aqui é uma conversa livre
// tipo "fale conosco": dúvidas, apelar de uma denúncia, pedir ajuda com a
// conta, etc. Uma thread por usuário (não por assunto).
model MensagemModeracao {
  id         String             @id @default(cuid())
  usuarioId  String             @map("usuario_id")
  usuario    Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  remetente  RemetenteModeracao
  conteudo   String
  // Rastreados separadamente porque cada lado lê a conversa em momentos
  // diferentes: o usuário quando abre o painel dele, o moderador quando
  // abre o painel externo.
  lidaPeloUsuario   Boolean @default(false) @map("lida_pelo_usuario")
  lidaPeloModerador Boolean @default(false) @map("lida_pelo_moderador")
  createdAt  DateTime           @default(now()) @map("created_at")

  @@index([usuarioId])
  @@index([createdAt])
  @@map("mensagens_moderacao")
}

// ---------- Estação de Rádio (cada usuário pode ter uma) ----------
// Permite que um usuário crie sua própria estação com uma lista ordenada
// de faixas. Quando "publicada", ela fica disponível no seletor de
// estações da tela de Rádio para qualquer ouvinte. Várias estações
// podem estar publicadas simultaneamente — a escolha é local de cada
// ouvinte e NÃO substitui a estação padrão do app.
model EstacaoRadio {
  id               String    @id @default(cuid())
  usuarioId        String    @unique @map("usuario_id")
  nome             String
  capaUrl          String?   @map("capa_url")
  // Bio/descrição opcional da estação, exibida no perfil e no seletor.
  bio              String?   @map("bio")
  // Flag que indica se esta estação está publicada/disponível no
  // seletor de estações. Múltiplas estações podem estar publicadas
  // ao mesmo tempo — cada ouvinte escolhe qual quer ouvir.
  publicada        Boolean   @default(false) @map("publicada")
  // Faixa atual da transmissão + timestamp de quando ela começou a tocar.
  // Usado para sincronizar ouvintes da mesma estação: ao entrar, cada
  // cliente calcula qual faixa deveria estar tocando.
  faixaAtualId     String?   @map("faixa_atual_id")
  faixaAtualInicio DateTime? @map("faixa_atual_inicio")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  // Soft-delete: ver comentário em Usuario.deletedAt.
  deletedAt        DateTime? @map("deleted_at")

  usuario      Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  faixasEstacao FaixaEstacao[]

  @@index([deletedAt])
  @@map("estacoes_radio")
}

// ---------- Faixas de uma Estação de Rádio (lista ordenada) ----------
// Tabela de junção entre EstacaoRadio e Faixa, com campo `ordem` pra
// preservar a ordem escolhida pelo dono da estação. onDelete Cascade
// nas duas pontas: se a estação ou a faixa for apagada, a entrada
// some junto (sem quebrar a estação).
model FaixaEstacao {
  id        String   @id @default(cuid())
  estacaoId String   @map("estacao_id")
  faixaId   String   @map("faixa_id")
  ordem     Int
  createdAt DateTime @default(now()) @map("created_at")

  estacao EstacaoRadio @relation(fields: [estacaoId], references: [id], onDelete: Cascade)
  faixa   Faixa        @relation(fields: [faixaId], references: [id], onDelete: Cascade)

  @@unique([estacaoId, faixaId])
  @@index([estacaoId])
  @@map("faixas_estacao")
}

// ---------- Rádio Zôada (estação padrão, controlada pela moderação) ----------
// A "Rádio Zôada" é a estação padrão/sempre disponível do app (dial da
// RadioScreen, ID especial '__default__' no cliente). Diferente das
// EstacaoRadio (uma por usuário), esta é uma SINGLETON — só existe uma
// linha, com ID fixo (RADIO_PADRAO_ID em src/lib/config.ts), controlada
// exclusivamente pelo painel de moderação (public/moderacao/index.html)
// via /api/moderacao/radio, com o mesmo MODERATION_SECRET de /api/reports
// e /api/aviso. O app só LÊ o estado atual, publicamente, via
// /api/radio-padrao (GET).
model RadioPadrao {
  id       String @id
  nome     String @default("Rádio Zôada")
  capaUrl  String? @map("capa_url")
  // Pausada pela moderação: enquanto true, o app não toca a Rádio Zôada
  // pra ninguém (mostra estado de "pausada" no lugar do player).
  pausada  Boolean @default(false)

  // Faixa atual da transmissão + timestamp de quando ela começou a tocar
  // (mesmo mecanismo de EstacaoRadio, usado pra sincronizar quem estiver
  // ouvindo ao mesmo tempo). Atualizado pela moderação ao avançar/pular
  // faixa, ou automaticamente ao trocar a playlist.
  faixaAtualId     String?   @map("faixa_atual_id")
  faixaAtualInicio DateTime? @map("faixa_atual_inicio")

  updatedAt DateTime @updatedAt @map("updated_at")

  faixas FaixaRadioPadrao[]

  @@map("radio_padrao")
}

// ---------- Faixas da Rádio Zôada (playlist ordenada, curada pela moderação) ----------
model FaixaRadioPadrao {
  id      String @id @default(cuid())
  radioId String @map("radio_id")
  faixaId String @map("faixa_id")
  ordem   Int    @default(0)

  radio RadioPadrao @relation(fields: [radioId], references: [id], onDelete: Cascade)
  faixa Faixa       @relation(fields: [faixaId], references: [id], onDelete: Cascade)

  @@unique([radioId, faixaId])
  @@index([radioId])
  @@map("faixas_radio_padrao")
}

// ---------- Denúncias (canal de denúncia/reporte — Marco Civil pós-STF 2025) ----------
// Cobre o ponto da decisão do STF de 2025 (Temas 533 e 987): o app precisa
// de um canal pelo qual QUALQUER usuário (não só o dono do conteúdo) possa
// notificar conteúdo ilícito/problemático, para que o Zôada possa agir de
// forma "clara e fundamentada" sem depender de ordem judicial. Cada
// denúncia é resolvida no painel de moderação separado (ver
// public/moderacao/index.html), que fala com /api/reports.
enum TipoAlvoDenuncia {
  POSTAGEM             // Postagem do feed (Postagem)
  COMENTARIO_POSTAGEM  // Comentário de uma postagem do feed (ComentarioPostagem)
  COMENTARIO_FAIXA     // Comentário numa faixa, no player (Comentario)
  FAIXA                // Faixa/música enviada (Faixa) — inclui infração de direitos autorais
  USUARIO              // Perfil/conta de um usuário (Usuario)

  @@map("tipo_alvo_denuncia")
}

enum StatusDenuncia {
  PENDENTE     // Ainda não analisada
  EM_ANALISE   // Um moderador está olhando
  RESOLVIDA    // Procedente — conteúdo removido/ação tomada
  REJEITADA    // Improcedente — nenhuma ação necessária

  @@map("status_denuncia")
}

model Denuncia {
  id        String           @id @default(cuid())
  tipoAlvo  TipoAlvoDenuncia @map("tipo_alvo")
  alvoId    String           @map("alvo_id")
  motivo    String
  // Detalhamento livre de quem denuncia (opcional).
  descricao String?

  // "Retrato" do conteúdo/autor denunciado, capturado no momento da
  // denúncia. Garante que o painel de moderação sempre tenha contexto
  // pra decidir, mesmo que o autor apague o conteúdo original depois
  // (o que, sem isso, faria a denúncia perder sentido).
  conteudoSnapshot String? @map("conteudo_snapshot")
  autorSnapshot    String? @map("autor_snapshot")
  autorId          String? @map("autor_id")

  // Quem denunciou. Nullable porque, se a conta de quem denunciou for
  // apagada depois, a denúncia em si deve continuar existindo (o registro
  // de moderação não pode sumir com a conta do denunciante).
  denuncianteId String?  @map("denunciante_id")
  denunciante   Usuario? @relation(fields: [denuncianteId], references: [id], onDelete: SetNull)

  status        StatusDenuncia @default(PENDENTE)
  // Anotação interna do moderador (motivo da resolução/rejeição).
  notaModeracao String?        @map("nota_moderacao")

  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  @@index([status])
  @@index([tipoAlvo, alvoId])
  @@index([createdAt])
  @@map("denuncias")
}

// ---------- Avisos (banner global disparado pelo painel de moderação) ----------
// Mensagem curta que aparece pra todo mundo na tela inicial do app (ex:
// manutenção programada, alerta de golpe circulando, aviso legal). Só o
// painel de moderação (public/moderacao/index.html, com MODERATION_SECRET)
// pode publicar ou remover — o app só lê o aviso ativo mais recente.
// Publicar um novo aviso desativa automaticamente o anterior: só existe UM
// aviso ativo por vez.
model Aviso {
  id        String   @id @default(cuid())
  mensagem  String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ativo])
  @@map("avisos")
}

// Admins do painel de moderação convidados dinamicamente (além dos fixos
// via env var MODERATION_ADMIN_EMAILS). O email precisa já existir como
// conta cadastrada no app (Usuario) — checado na hora de convidar, não
// aqui no banco (evita ter que manter uma FK que quebraria se a conta
// fosse apagada).
model AdminModeracao {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admins_moderacao")
}
