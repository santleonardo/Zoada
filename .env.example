# ============================================================
# ZÔADA — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# ---------- NEON (Postgres) ----------
# Get from: https://console.neon.tech → Project → Connection Details
# Format: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
NEON_DATABASE_URL=postgresql://neondb_owner:npg_G0Z5INvFHrgT@ep-autumn-sea-ackxo4y6-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ---------- CLOUDFLARE R2 ----------
# Get from: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=zoada-storage
R2_PUBLIC_URL=

# ---------- JWT AUTH ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=7d
